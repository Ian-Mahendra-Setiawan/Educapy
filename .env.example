PORT=3000
# User dan database ini HARUS sudah dibuat di PostgreSQL (lihat README, bagian Menyiapkan database)
# Jika password mengandung karakter khusus, ubah dengan URL-encode (contoh: @ menjadi %40)
DATABASE_URL=postgresql://educapy:educapy@localhost:5432/educapy
# Wajib diganti: minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Dipakai oleh `npm run admin:create`
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@capybara.local
ADMIN_PASSWORD=Ganti#Password1
